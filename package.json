{
  "name": "geohash-chat",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,web \"tsx watch apps/api/src/local.ts\" \"vite --config apps/web/vite.config.ts\"",
    "build": "npm run typecheck && vite build --config apps/web/vite.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && vitest run",
    "synth": "cdk synth",
    "deploy": "npm run build && cdk deploy --outputs-file cdk-outputs.json",
    "format": "prettier --write apps packages infra test docs README.md package.json tsconfig.json cdk.json vitest.config.ts"
  },
  "dependencies": {
    "@aws-sdk/client-cognito-identity-provider": "^3.0.0",
    "@aws-sdk/client-dynamodb": "^3.0.0",
    "@aws-sdk/lib-dynamodb": "^3.0.0",
    "aws-cdk-lib": "2.275.0",
    "aws-jwt-verify": "^5.0.0",
    "constructs": "^10.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "aws-cdk": "^2.1000.0",
    "concurrently": "^9.0.0",
    "esbuild": "^0.25.0",
    "prettier": "^3.9.10",
    "tsx": "^4.0.0",
    "typescript": "^5.8.0",
    "vite": "^7.0.0",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=22.12"
  }
}
